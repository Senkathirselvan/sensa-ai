# ==============================================================================
# 🔑 Multi-Agent Job Platform — Master Configuration
# ==============================================================================

# 1. AI Model API Keys (Free Tiers Available)
# Get free NVIDIA NIM key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Get free Gemini key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 2. Per-Agent Model Assignments (Format: <provider>/<model_name>)
MANAGER_LLM=nvidia/meta/llama-3.3-70b-instruct
SCOUT_LLM=ollama/qwen2.5:7b
TAILOR_LLM=gemini/gemini-2.5-flash
APPLY_LLM=ollama/qwen2.5:7b

DEFAULT_LLM=ollama/qwen2.5:7b

# 3. Optional: RapidAPI key for secondary job search fallback
RAPIDAPI_KEY=
