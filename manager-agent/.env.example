PORT=8005
HOST=0.0.0.0
ENVIRONMENT=development

# Worker Agent Microservice Endpoints
JOB_FIND_AGENT_URL=http://localhost:8000
RESUME_PREP_AGENT_URL=http://localhost:8001
JOB_APPLY_AGENT_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3001

# AI Model Configuration
DEFAULT_MODEL=auto
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ROUTER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Database Configuration (PostgreSQL 16 with SQLite fallback)
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent_secret@localhost:5432/jobagent_db
SQLITE_URL=sqlite+aiosqlite:///./data/manager.db

